{
  "name": "quick open",
  "description": "quick open a link by select params",
  "version": "0.1",
  "background": {
    "service_worker": "src/dist/service_worker.bundle.js",
    "type": "module"
  },
  "action": {
    "default_icon": "src/dist/icon.png"
  },
  "omnibox": {
    "keyword": "q"
  },
  "permissions": [
    "storage"
  ],
  "options_page": "src/options.html",
  "manifest_version": 3
}
